{
  "name": "datadrop",
  "version": "1.0.0",
  "description": "Paste any public data file URL, get an AI-built dashboard. All in the browser (DuckDB-WASM + Vega-Lite).",
  "scripts": {
    "build": "node build.mjs",
    "build:min": "node build.mjs --minify",
    "build:stub": "node build.mjs --stub",
    "serve": "node serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node build.mjs --stub && node tests/ui.e2e.mjs",
    "test:duck": "node tests/duck.e2e.mjs",
    "test:full": "node build.mjs && node tests/full.e2e.mjs",
    "test:e2e": "npm run test:duck && npm run test:full",
    "check": "node scripts/check.mjs",
    "check:serial": "npm test && npm run test:ui && npm run build",
    "check:full": "node scripts/check.mjs --full",
    "check:full:serial": "npm run check:serial && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.29.0",
    "vega": "5.30.0",
    "vega-embed": "6.26.0",
    "vega-lite": "5.21.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "playwright": "1.48.2"
  },
  "type": "module"
}
